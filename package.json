{
  "name": "prediction-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "tsx --test tests/**/*.test.ts",
    "test:db": "tsx --test tests/many-users.db-test.ts",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:knockout": "npx tsx prisma/seed-knockout.ts",
    "db:seed:knockout:demo": "npx tsx prisma/seed-knockout.ts --demo",
    "db:seed:test-bracket": "npx tsx prisma/seed-test-bracket.ts",
    "db:prepare-production": "npx tsx prisma/prepare-production-data.ts",
    "db:backup:predictions": "npx tsx scripts/export-predictions-csv.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "next": "15.0.5",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "15.0.5",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
