generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  displayName String
  email       String   @unique
  password    String   // bcrypt hash
  createdAt   DateTime @default(now())
}

model Team {
  id          String   @id  // 3-letter FIFA code, e.g. "BRA", "ARG", "ENG"
  name        String         // Display name in Swedish, e.g. "Brasilien"
  group       String?        // "A"–"L"; null if not yet assigned
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
}

model Match {
  id          String   @id @default(cuid())
  homeTeamId  String
  awayTeamId  String
  homeTeam    Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  scheduledAt DateTime
  venue       String
  city        String
  country     String   // "USA" | "Canada" | "Mexico"
  stage       String   // "group" | "r32" | "r16" | "qf" | "sf" | "3p" | "final"
  group       String?  // "A"–"L" for group stage; null for knockouts
  matchNumber    Int?     // official FIFA match number
  status         String   @default("upcoming") // "upcoming" | "live" | "completed"
  homeScore      Int?     // null until played
  awayScore      Int?     // null until played
  minute         String?  // current match minute, e.g. "45+2" — only set when live
  sportsDbId     String?  @unique // event id from TheSportsDB for syncing
  knockoutWinner String?  // "home" | "away" — who won after full match (incl. ET/PEN); knockout stages only
  // Bracket linkage — only set for knockout matches.
  // When this match completes, the winning team becomes the home/away slot of `nextMatch`.
  bracketCode    String?  @unique // stable identifier within the bracket: "R32-1", "R16-1", "QF-1", "SF-1", "F", "3P"
  nextMatchCode  String?  // bracketCode of the match the winner advances into (null for final/3p)
  nextMatchSlot  String?  // "home" | "away" — which slot of the next match this winner fills
  predictions Prediction[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Group {
  id           String            @id @default(cuid())
  name         String
  inviteCode   String            @unique @default(cuid())
  createdBy    String            // User.id
  createdAt    DateTime          @default(now())
  members      GroupMembership[]
  predictions  Prediction[]
  chatMessages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  groupId   String
  userId    String   // User.id (no FK constraint)
  content   String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model GroupMembership {
  id       String   @id @default(cuid())
  userId   String   // User.id
  groupId  String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

// Scoring (stage-dependent):
//   Group stage:  3 pts — exact score | 1 pt — correct result | 0 — wrong result
//   Knockout:     2 pts — correct winning team (predict the team, not the side)
//   Final:        5 pts — correct winning team + exact 90-min score
//                 3 pts — correct winning team only
//                 0 pts — wrong winning team
//
// Cascading penalty: knockout predictions store the predicted winning *team* (FIFA code).
// If the team is eliminated earlier, the prediction scores 0 automatically because that
// team won't be in the match at all — no special logic required.
model Prediction {
  id                    String   @id @default(cuid())
  userId                String   // User.id
  matchId               String
  groupId               String
  predictedHome         Int?     // null for knockout (non-final) predictions
  predictedAway         Int?     // null for knockout (non-final) predictions
  predictedWinner       String?  // legacy "home"|"away" — kept for any pre-existing data
  predictedWinnerTeamId String?  // FIFA code of the team the user predicts will win — knockouts + final
  score                 Int?     // null until match is complete and scored
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  match         Match    @relation(fields: [matchId], references: [id])
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId, groupId])
}
